# Client vars are inlined at build time. Set the same EXPO_PUBLIC_* keys on Vercel
# for production (use your Convex production URL, not the local one).
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Set this on the Convex deployment too:
# npx convex env set PRIVY_APP_ID <same-as-EXPO_PUBLIC_PRIVY_APP_ID>
PRIVY_APP_ID=

# Optional ChatGPT fallback if the Convex AI Gateway is not enabled:
# npx convex env set OPENAI_API_KEY <your-openai-key>
OPENAI_API_KEY=

# Optional YouTube Data API key. Without it, course search uses YouTube's public search API:
# npx convex env set YOUTUBE_API_KEY <your-youtube-data-api-key>
YOUTUBE_API_KEY=
